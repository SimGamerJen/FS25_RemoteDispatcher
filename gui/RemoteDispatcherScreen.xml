<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<GUI onOpen="onOpen" onClose="onClose" onCreate="onCreate">
    <Bitmap profile="dialogFullscreenBg" id="dialogBg" />
    <GuiElement profile="fs25_dialogBg" id="dialogElement" size="1040px 500px">
        <ThreePartBitmap profile="fs25_dialogBgMiddle" />
        <ThreePartBitmap profile="fs25_dialogBgTop" />
        <ThreePartBitmap profile="fs25_dialogBgBottom" />

        <GuiElement profile="fs25_dialogContentContainer">
            <Text profile="dialogTitle" text="$l10n_rd_title" id="dialogTitleElement" position="0px -30px" />

            <Text profile="rdMetaText" id="connectionText" position="40px -78px" size="925px 26px" text="$l10n_rd_hp_unavailable" />
            <ThreePartBitmap profile="fs25_lineSeparatorTopHighlighted" position="40px -108px" size="925px 2px" />

            <Text profile="rdHeaderLeft" position="40px -126px" size="925px 28px" text="$l10n_rd_header_vehicles" />

            <Text profile="rdHeaderLeft" position="48px -158px" size="205px 30px" text="$l10n_rd_col_vehicle" />
            <Text profile="rdHeaderLeft" position="258px -158px" size="70px 30px" text="$l10n_rd_col_auto" />
            <Text profile="rdHeaderLeft" position="335px -158px" size="90px 30px" text="$l10n_rd_col_state" />
            <Text profile="rdHeaderLeft" position="432px -158px" size="145px 30px" text="$l10n_rd_col_worker" />
            <Text profile="rdHeaderLeft" position="584px -158px" size="365px 30px" text="$l10n_rd_col_task" />

            <SmoothList profile="rdList" id="vehicleTable" position="45px -190px" size="905px 205px" focusInit="onOpen">
                <ListItem profile="rdListItem" name="vehicleRowTemplate" size="905px 40.77px">
                    <Text profile="rdRowCellLeft" position="8px 0px" size="202px 40.77px" name="Vehicle" textLayoutMode="scrolling" />
                    <Text profile="rdRowCellLeft" position="215px 0px" size="68px 40.77px" name="Auto" />
                    <Text profile="rdRowCellLeft" position="292px 0px" size="86px 40.77px" name="State" />
                    <Text profile="rdRowCellLeft" position="389px 0px" size="140px 40.77px" name="Worker" textLayoutMode="scrolling" />
                    <Text profile="rdRowCellLeft" position="541px 0px" size="350px 40.77px" name="Task" textLayoutMode="scrolling" />
                </ListItem>
            </SmoothList>
            <ThreePartBitmap profile="fs25_listSliderBox" position="955px -190px" size="12px 205px">
                <Slider profile="fs25_listSlider" size="6px 197px" dataElementId="vehicleTable" id="vehicleSlider" />
            </ThreePartBitmap>

            <ThreePartBitmap profile="fs25_lineSeparatorTopHighlighted" position="40px -408px" size="925px 2px" />
            <Text profile="rdMetaText" id="targetText" position="45px -426px" size="915px 28px" text="$l10n_rd_target_none" textLayoutMode="scrolling" />
            <Text profile="rdMetaText" id="statusText" position="45px -458px" size="915px 28px" text="$l10n_rd_status_cinematic" textLayoutMode="scrolling" />
        </GuiElement>

        <BoxLayout profile="fs25_dialogButtonBox" size="990px 60px">
            <Button profile="buttonBack" text="$l10n_rd_button_close" onClick="onClickBack" />
            <Button profile="rdButtonProvider" id="providerButton" text="$l10n_rd_button_automation" onClick="onClickCycleProvider" />
            <Button profile="rdButtonWorker" id="workerButton" text="$l10n_rd_button_worker" onClick="onClickCycleWorker" />
        </BoxLayout>
    </GuiElement>
</GUI>
