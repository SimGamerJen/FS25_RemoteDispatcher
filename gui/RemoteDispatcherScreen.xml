<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<GUI onOpen="onOpen" onClose="onClose" onCreate="onCreate">
    <Bitmap profile="dialogFullscreenBg" id="dialogBg" />
    <GuiElement profile="fs25_dialogBg" id="dialogElement" size="1220px 610px">
        <ThreePartBitmap profile="fs25_dialogBgMiddle" />
        <ThreePartBitmap profile="fs25_dialogBgTop" />
        <ThreePartBitmap profile="fs25_dialogBgBottom" />

        <GuiElement profile="fs25_dialogContentContainer">
            <Text profile="dialogTitle" text="$l10n_rd_management_title" id="dialogTitleElement" position="0px -30px" />
            <Text profile="rdMetaText" id="connectionText" position="45px -76px" size="1105px 28px" text="$l10n_rd_hp_unavailable" />
            <ThreePartBitmap profile="fs25_lineSeparatorTopHighlighted" position="45px -108px" size="1105px 2px" />

            <Text profile="rdSectionTitle" position="45px -132px" size="660px 28px" text="$l10n_rd_header_vehicles" />
            <Text profile="rdHeaderLeft" position="52px -163px" size="170px 30px" text="$l10n_rd_col_vehicle" />
            <Text profile="rdHeaderLeft" position="225px -163px" size="62px 30px" text="$l10n_rd_col_auto" />
            <Text profile="rdHeaderLeft" position="292px -163px" size="82px 30px" text="$l10n_rd_col_state" />
            <Text profile="rdHeaderLeft" position="380px -163px" size="105px 30px" text="$l10n_rd_col_worker" />
            <Text profile="rdHeaderLeft" position="490px -163px" size="205px 30px" text="$l10n_rd_col_task" />

            <SmoothList profile="rdList" id="vehicleTable" position="50px -197px" size="650px 285px" focusInit="onOpen" focusChangeRight="workerTable">
                <ListItem profile="rdListItem" name="vehicleRowTemplate" size="650px 40.77px">
                    <Text profile="rdRowCellLeft" position="5px 0px" size="168px 40.77px" name="Vehicle" textLayoutMode="scrolling" />
                    <Text profile="rdRowCellLeft" position="175px 0px" size="62px 40.77px" name="Auto" />
                    <Text profile="rdRowCellLeft" position="242px 0px" size="82px 40.77px" name="State" />
                    <Text profile="rdRowCellLeft" position="330px 0px" size="105px 40.77px" name="Worker" textLayoutMode="scrolling" />
                    <Text profile="rdRowCellLeft" position="440px 0px" size="205px 40.77px" name="Task" textLayoutMode="scrolling" />
                </ListItem>
            </SmoothList>
            <ThreePartBitmap profile="fs25_listSliderBox" position="705px -197px" size="12px 285px">
                <Slider profile="fs25_listSlider" size="6px 277px" dataElementId="vehicleTable" id="vehicleSlider" />
            </ThreePartBitmap>

            <Text profile="rdSectionTitle" position="760px -132px" size="390px 28px" text="$l10n_rd_header_workers" />
            <Text profile="rdHeaderLeft" position="767px -163px" size="55px 30px" text="$l10n_rd_col_slot" />
            <Text profile="rdHeaderLeft" position="827px -163px" size="190px 30px" text="$l10n_rd_col_worker" />
            <Text profile="rdHeaderLeft" position="1022px -163px" size="120px 30px" text="$l10n_rd_col_state" />

            <SmoothList profile="rdList" id="workerTable" position="765px -197px" size="375px 285px" focusChangeLeft="vehicleTable">
                <ListItem profile="rdListItem" name="workerRowTemplate" size="375px 40.77px">
                    <Text profile="rdRowCellLeft" position="5px 0px" size="55px 40.77px" name="Slot" />
                    <Text profile="rdRowCellLeft" position="65px 0px" size="190px 40.77px" name="Worker" textLayoutMode="scrolling" />
                    <Text profile="rdRowCellLeft" position="260px 0px" size="110px 40.77px" name="State" />
                </ListItem>
            </SmoothList>
            <ThreePartBitmap profile="fs25_listSliderBox" position="1145px -197px" size="12px 285px">
                <Slider profile="fs25_listSlider" size="6px 277px" dataElementId="workerTable" id="workerSlider" />
            </ThreePartBitmap>

            <ThreePartBitmap profile="fs25_lineSeparatorTopHighlighted" position="45px -500px" size="1105px 2px" />
            <Text profile="rdMetaText" id="detailText" position="50px -518px" size="1095px 30px" text="$l10n_rd_detail_none" textLayoutMode="scrolling" />
            <Text profile="rdMetaText" id="statusText" position="50px -551px" size="1095px 30px" text="$l10n_rd_management_hint" textLayoutMode="scrolling" />
        </GuiElement>

        <BoxLayout profile="fs25_dialogButtonBox" size="1170px 60px">
            <Button profile="buttonBack" text="$l10n_rd_button_close" onClick="onClickBack" />
            <Button profile="rdButtonProvider" id="providerButton" text="$l10n_rd_button_automation" onClick="onClickCycleProvider" />
            <Button profile="rdButtonAssign" id="assignButton" text="$l10n_rd_button_assign" onClick="onClickAssignWorker" />
        </BoxLayout>
    </GuiElement>
</GUI>
