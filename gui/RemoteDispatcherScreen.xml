<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<GUI onOpen="onOpen" onClose="onClose" onCreate="onCreate">
    <Bitmap profile="dialogFullscreenBg" id="dialogBg" />
    <GuiElement profile="fs25_dialogBg" id="dialogElement" size="1120px 540px">
        <ThreePartBitmap profile="fs25_dialogBgMiddle" />
        <ThreePartBitmap profile="fs25_dialogBgTop" />
        <ThreePartBitmap profile="fs25_dialogBgBottom" />

        <GuiElement profile="fs25_dialogContentContainer">
            <Text profile="dialogTitle" text="$l10n_rd_management_title" id="dialogTitleElement" position="0px -30px" />
            <Text profile="rdMetaText" id="connectionText" position="45px -76px" size="1005px 28px" text="$l10n_rd_hp_unavailable" />
            <ThreePartBitmap profile="fs25_lineSeparatorTopHighlighted" position="45px -108px" size="1005px 2px" />

            <Text profile="rdHeaderLeft" position="50px -135px" size="225px 32px" text="$l10n_rd_col_vehicle" />
            <Text profile="rdHeaderLeft" position="280px -135px" size="90px 32px" text="$l10n_rd_col_auto" />
            <Text profile="rdHeaderLeft" position="375px -135px" size="110px 32px" text="$l10n_rd_col_state" />
            <Text profile="rdHeaderLeft" position="490px -135px" size="155px 32px" text="$l10n_rd_col_worker" />
            <Text profile="rdHeaderLeft" position="650px -135px" size="390px 32px" text="$l10n_rd_col_task" />

            <SmoothList profile="rdList" id="vehicleTable" position="50px -170px" size="990px 245px" focusInit="onOpen">
                <ListItem profile="rdListItem" name="vehicleRowTemplate" size="990px 40.77px">
                    <Text profile="rdRowCellLeft" position="5px 0px" size="220px 40.77px" name="Vehicle" textLayoutMode="scrolling" />
                    <Text profile="rdRowCellLeft" position="230px 0px" size="88px 40.77px" name="Auto" />
                    <Text profile="rdRowCellLeft" position="325px 0px" size="105px 40.77px" name="State" />
                    <Text profile="rdRowCellLeft" position="440px 0px" size="150px 40.77px" name="Worker" textLayoutMode="scrolling" />
                    <Text profile="rdRowCellLeft" position="600px 0px" size="380px 40.77px" name="Task" textLayoutMode="scrolling" />
                </ListItem>
            </SmoothList>
            <ThreePartBitmap profile="fs25_listSliderBox" position="1045px -170px" size="12px 245px">
                <Slider profile="fs25_listSlider" size="6px 237px" dataElementId="vehicleTable" id="vehicleSlider" />
            </ThreePartBitmap>

            <ThreePartBitmap profile="fs25_lineSeparatorTopHighlighted" position="45px -430px" size="1005px 2px" />
            <Text profile="rdMetaText" id="detailText" position="50px -448px" size="990px 32px" text="$l10n_rd_detail_none" textLayoutMode="scrolling" />
            <Text profile="rdMetaText" id="statusText" position="50px -480px" size="990px 32px" text="$l10n_rd_management_hint" textLayoutMode="scrolling" />
        </GuiElement>

        <BoxLayout profile="fs25_dialogButtonBox" size="1070px 60px">
            <Button profile="buttonBack" text="$l10n_rd_button_close" onClick="onClickBack" />
            <Button profile="rdButtonAction" id="providerButton" text="$l10n_rd_button_automation" onClick="onClickCycleProvider" />
            <Button profile="rdButtonAction" id="workerButton" text="$l10n_rd_button_worker" onClick="onClickCycleWorker" />
        </BoxLayout>
    </GuiElement>
</GUI>
