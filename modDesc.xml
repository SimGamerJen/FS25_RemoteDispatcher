<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<modDesc xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" descVersion="110" xsi:noNamespaceSchemaLocation="https://validation.gdn.giants-software.com/xml/fs25/modDesc.xsd">
    <author>SimGamerJen / ChatGPT prototype</author>
    <version>0.2.0.0</version>

    <title>
        <en>Remote Dispatcher</en>
    </title>

    <description>
        <en><![CDATA[
Remote Dispatcher remotely starts and stops already-prepared AutoDrive and Courseplay tasks without entering the vehicle.

Version 0.2 introduces a proper dispatcher GUI and optional HelperProfiles API v7 integration. Vehicles can be assigned a specific enabled worker or left on AUTO. Named assignments are enforced only for the scoped hire triggered by that dispatch and do not change the normal HelperProfiles selection.

Single-player alpha intended for testing and cinematic workflows.
        ]]></en>
    </description>

    <multiplayer supported="false" />
    <l10n filenamePrefix="translations/l10n" defaultLanguage="en" />

    <extraSourceFiles>
        <sourceFile filename="scripts/RemoteDispatcher.lua" />
        <sourceFile filename="scripts/RemoteDispatcherDiscoveryFix.lua" />
        <sourceFile filename="scripts/RemoteDispatcherUIFix.lua" />
        <sourceFile filename="scripts/RemoteDispatcherActivationFix.lua" />
        <sourceFile filename="scripts/RemoteDispatcherHelperProfiles.lua" />
        <sourceFile filename="scripts/RemoteDispatcherScreen.lua" />
    </extraSourceFiles>

    <actions>
        <action name="RDC_TOGGLE_UI" category="ONFOOT" axisType="HALF" />
        <action name="RDC_REMOTE_ACTION" category="ONFOOT" axisType="HALF" />
    </actions>

    <inputBinding>
        <actionBinding action="RDC_TOGGLE_UI">
            <binding device="KB_MOUSE_DEFAULT" input="KEY_lctrl KEY_lalt KEY_d" />
        </actionBinding>
        <actionBinding action="RDC_REMOTE_ACTION">
            <binding device="KB_MOUSE_DEFAULT" input="KEY_lctrl KEY_lalt KEY_r" />
        </actionBinding>
    </inputBinding>
</modDesc>
